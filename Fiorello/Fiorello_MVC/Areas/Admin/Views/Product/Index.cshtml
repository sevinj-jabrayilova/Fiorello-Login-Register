@model IEnumerable<ProductVM>

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2>Products</h2>
        <a class="btn btn-success" asp-area="Admin" asp-controller="Product" asp-action="Create">Create New</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="width:120px">Image</th>
                    <th scope="col">Name</th>
                    <th scope="col">Category</th>
                    <th scope="col" style="width:200px">Operations</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="~/assets/img/@item.Image"
                                 class="img-thumbnail"
                                 style="width:100px; height:70px; object-fit:cover;" />
                        </td>
                        <td>@item.Name</td>
                        <td>@item.Category</td>
                        <td>
                            <a class="btn btn-primary btn-sm me-1" asp-area="Admin" asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id">Detail</a>
                            <a class="btn btn-warning btn-sm me-1" asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id">Update</a>
                            <a class="btn btn-danger btn-sm delete-product" data-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
