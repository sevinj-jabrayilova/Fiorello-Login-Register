@model ProductDetailVM
<div class="container py-5">
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">

                @{
                    var mainImage = Model.Images?.FirstOrDefault(m => m.IsMain);
                }

                @if (mainImage != null)
                {
                    <img src="~/assets/img/@mainImage.Image" class="card-img-top img-fluid"
                         style="max-height:300px; object-fit:contain;" alt="Product Image">
                }
                else
                {
                    <img src="~/assets/img/default.png" class="card-img-top" alt="Default Image">
                }
                <div class="card-body">
                    <div class="row g-2">
                        @foreach (var item in Model.Images)
                        {
                            <div class="col-3">
                                <img src="~/assets/img/@item.Image" class="img-thumbnail" alt="Thumbnail 1">
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <h1 class="h2 mb-3">@Model.Name</h1>
            <div class="mb-3">
                <span class="h4 me-2">@Model.Price</span>
            </div>

            <p class="mb-4">
                @Model.Description
            </p>


        </div>
    </div>
</div>